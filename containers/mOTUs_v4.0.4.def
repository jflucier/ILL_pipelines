# build new image using this command:
# singularity build --force --fakeroot mOTUs_v4.0.4.sif mOTUs_v4.0.4.def


BootStrap: docker
From: ubuntu:22.04

#%files
#  /home/jflucier/localhost/projet/ILL_pipelines/containers/microbeannotator.2.0.5.refseq_data_downloader.patch /temp/refseq_data_downloader.py

%setup

%environment
  export PATH=/miniconda3/bin:$PATH

%post
  apt-get update && apt-get -y upgrade

  ln -fs /usr/share/zoneinfo/America/New_York /etc/localtime

  # # needed for concoct
  export DEBIAN_FRONTEND=noninteractive
  apt-get -y install \
  build-essential \
  wget \
  git \
  less

  rm -rf /var/lib/apt/lists/*
  apt-get clean

  #Installing Anaconda 3 https://repo.anaconda.com/miniconda/Miniconda3-py39_4.11.0-Linux-x86_64.sh
  cd /
  mkdir -p /miniconda3
  wget https://repo.anaconda.com/miniconda/Miniconda3-py312_25.11.1-1-Linux-x86_64.sh -O /miniconda3/miniconda.sh
  /bin/bash /miniconda3/miniconda.sh -b -u -p /miniconda3
  rm -rf /miniconda3/miniconda.sh
  export PATH=/miniconda3/bin:$PATH
  export CONDA_PLUGINS_AUTO_ACCEPT_TOS=yes

  conda config --file /miniconda3/.condarc --add channels defaults
  conda config --file /miniconda3/.condarc --add channels conda-forge
  conda config --file /miniconda3/.condarc --add channels bioconda

  echo ". /miniconda3/etc/profile.d/conda.sh" >> $SINGULARITY_ENVIRONMENT
  echo "conda activate mOTUs4" >> $SINGULARITY_ENVIRONMENT

  . /miniconda3/etc/profile.d/conda.sh

  cd /
  conda create -n mOTUs4 python==3.12 bwa=0.7.19 vsearch pip
  conda activate mOTUs4
  python -m pip install motus-tool

#  echo "loading motus help for test purpose"
#  motus --help
#  echo "done testing motus"

  conda deactivate
